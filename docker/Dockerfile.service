# Build one independently executable Spring Boot service from the backend monorepo.
FROM gradle:8.14.7-jdk21 AS builder
ARG SERVICE_NAME
WORKDIR /workspace
COPY . .
RUN gradle --no-daemon :${SERVICE_NAME}:bootJar

FROM eclipse-temurin:21-jre
ARG SERVICE_NAME
WORKDIR /app
RUN useradd --system --uid 10001 spring
COPY --from=builder /workspace/${SERVICE_NAME}/build/libs/${SERVICE_NAME}.jar /app/app.jar
USER spring
EXPOSE 8081 8082 8083 8084
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
